# Supabase project URL and anon key (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional public base URL of an external API (no trailing slash).
# Leave empty to use Next.js same-origin API routes (/api/v1), ideal for Vercel.
NEXT_PUBLIC_API_URL=
