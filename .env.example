# Supabase project URL and anon key (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional public base URL of an external API (no trailing slash).
# Leave empty to use Next.js same-origin API routes (/api/v1), ideal for Vercel.
NEXT_PUBLIC_API_URL=

# Resend API key for transactional emails (https://resend.com)
RESEND_API_KEY=re_placeholder

# Google Gemini API key for AI Project Manager
GEMINI_API_KEY=your-gemini-api-key

# Gemini model name (optional, defaults to gemini-flash-latest).
# Falls back to gemini-pro-latest if the configured model is unavailable.
GEMINI_MODEL=
