ENVIRONMENT=development
DEBUG=true

# --- Database ---------------------------------------------------------------
# PRODUCTION / DEV target: Neon serverless Postgres.
# Paste the connection string from the Neon dashboard. The app automatically
# switches to the asyncpg driver and handles `sslmode=require`.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/orbit?sslmode=require
#
# Local fallback with zero setup (SQLite) — fine for smoke tests only:
DATABASE_URL=sqlite+aiosqlite:///./orbit.db

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
