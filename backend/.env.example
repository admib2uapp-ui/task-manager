ENVIRONMENT=development
DEBUG=true

# --- Database ---------------------------------------------------------------
# PRODUCTION / DEV target: Neon serverless Postgres.
# Paste the connection string from the Neon dashboard. The app automatically
# switches to the asyncpg driver and handles `sslmode=require`.
#
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/orbit?sslmode=require
#
# Local fallback with zero setup (SQLite) — fine for smoke tests only:
DATABASE_URL=sqlite+aiosqlite:///./orbit.db

# --- Security ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS -------------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OAuth (optional; leave blank to keep social login disabled) ------------
# Frontend base (where users are sent back after login) and backend base
# (used to build the provider callback URL).
FRONTEND_URL=http://localhost:3000
OAUTH_REDIRECT_BASE=http://localhost:8000
# Google: create credentials at https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {OAUTH_REDIRECT_BASE}/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: create an OAuth App at https://github.com/settings/developers
#   Authorization callback URL: {OAUTH_REDIRECT_BASE}/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Vercel deployment notes -----------------------------------------------
# Set these in Vercel Project Settings -> Environment Variables.
# - ENVIRONMENT=production
# - OAUTH_REDIRECT_BASE=https://<your-backend>.vercel.app
# - FRONTEND_URL=https://<your-frontend>.vercel.app
# - BACKEND_CORS_ORIGINS=https://<your-frontend>.vercel.app
# Optional: override upload path (defaults to /tmp/uploads on Vercel runtime)
# UPLOAD_DIR=/tmp/uploads
